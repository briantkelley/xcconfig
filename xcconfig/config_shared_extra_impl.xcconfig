CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_NO =
CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_YES = -Wcustom-atomic-properties
CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_YES_ERROR = -Werror=custom-atomic-properties

CLANG_WARN_SWITCH_DEFAULT_NO =
CLANG_WARN_SWITCH_DEFAULT_YES = -Wswitch-default
CLANG_WARN_SWITCH_DEFAULT_YES_ERROR = -Werror=switch-default

CLANG_WARN_UNUSED_BUT_SET_VARIABLE_NO =
CLANG_WARN_UNUSED_BUT_SET_VARIABLE_YES = -Wunused-but-set-variable
CLANG_WARN_UNUSED_BUT_SET_VARIABLE_YES_ERROR = -Werror=unused-but-set-variable

CLANG_WARN_EXTRA_CFLAGS = \
    $(CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_$(CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES)) \
    $(CLANG_WARN_SWITCH_DEFAULT_$(CLANG_WARN_SWITCH_DEFAULT)) \
    $(CLANG_WARN_UNUSED_BUT_SET_VARIABLE_$(CLANG_WARN_UNUSED_BUT_SET_VARIABLE))
