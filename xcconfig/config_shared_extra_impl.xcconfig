//
// This file contains implementation details for `config_shared_extra.xcconfig`.
// Do not edit this file. See `config_extra.xcconfig` or `README.markdown` for
// information about customizing build settings.
//

CLANG_WARN_CAST_FUNCTION_TYPE_MISMATCH = -Wcast-function-type-mismatch
CLANG_WARN_CAST_FUNCTION_TYPE_MISMATCH_ERROR = -Werror=cast-function-type-mismatch
CLANG_WARN_CAST_FUNCTION_TYPE_STRICT = -Wcast-function-type-strict
CLANG_WARN_CAST_FUNCTION_TYPE_STRICT_ERROR = -Werror=cast-function-type-strict

CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_YES = -Wcustom-atomic-properties
CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_YES_ERROR = -Werror=custom-atomic-properties

CLANG_WARN_GLOBAL_CONSTRUCTORS_YES = -Wglobal-constructors
CLANG_WARN_GLOBAL_CONSTRUCTORS_YES_ERROR = -Werror=global-constructors

CLANG_WARN_OBJC_LOAD_METHOD_YES = -Wobjc-load-method
CLANG_WARN_OBJC_LOAD_METHOD_YES_ERROR = -Werror=objc-load-method

CLANG_WARN_RESERVED_IDENTIFIER_YES = -Wreserved-identifier
CLANG_WARN_RESERVED_IDENTIFIER_YES_ERROR = -Werror=reserved-identifier

CLANG_WARN_SUGGEST_DESTRUCTOR_OVERRIDE_YES = -Wsuggest-destructor-override
CLANG_WARN_SUGGEST_DESTRUCTOR_OVERRIDE_YES_ERROR = -Werror=suggest-destructor-override

CLANG_WARN_SUGGEST_OVERRIDE_YES = -Wsuggest-override
CLANG_WARN_SUGGEST_OVERRIDE_YES_ERROR = -Werror=suggest-override

CLANG_WARN_SWITCH_DEFAULT_YES = -Wswitch-default
CLANG_WARN_SWITCH_DEFAULT_YES_ERROR = -Werror=switch-default

CLANG_WARN_UNUSED_BUT_SET_VARIABLE_YES = -Wunused-but-set-variable
CLANG_WARN_UNUSED_BUT_SET_VARIABLE_YES_ERROR = -Werror=unused-but-set-variable

CLANG_WARN_WEAK_VTABLES_YES = -Wweak-vtables
CLANG_WARN_WEAK_VTABLES_YES_ERROR = -Werror=weak-vtables

// Note: Xcode 13 added support for the line continuation operator (`\`).
CLANG_WARN_EXTRA_CFLAGS = \
    $(CLANG_WARN_CAST_FUNCTION_TYPE_MISMATCH_$(CLANG_WARN_CAST_FUNCTION_TYPE_MISMATCH)_STRICT_$(CLANG_WARN_CAST_FUNCTION_TYPE_STRICT)) \
    $(CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES_$(CLANG_WARN_CUSTOM_ATOMIC_PROPERTIES)) \
    $(CLANG_WARN_GLOBAL_CONSTRUCTORS_$(CLANG_WARN_GLOBAL_CONSTRUCTORS)) \
    $(CLANG_WARN_OBJC_LOAD_METHOD_$(CLANG_WARN_OBJC_LOAD_METHOD)) \
    $(CLANG_WARN_RESERVED_IDENTIFIER_$(CLANG_WARN_RESERVED_IDENTIFIER)) \
    $(CLANG_WARN_SUGGEST_DESTRUCTOR_OVERRIDE_$(CLANG_WARN_SUGGEST_DESTRUCTOR_OVERRIDE)) \
    $(CLANG_WARN_SUGGEST_OVERRIDE_$(CLANG_WARN_SUGGEST_OVERRIDE)) \
    $(CLANG_WARN_SWITCH_DEFAULT_$(CLANG_WARN_SWITCH_DEFAULT)) \
    $(CLANG_WARN_UNUSED_BUT_SET_VARIABLE_$(CLANG_WARN_UNUSED_BUT_SET_VARIABLE)) \
    $(CLANG_WARN_WEAK_VTABLES_$(CLANG_WARN_WEAK_VTABLES))
